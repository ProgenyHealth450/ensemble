#!/bin/sh
#
# Refuses a push from a branch behind its upstream.
#
# Fast feedback only. This is NOT the enforcement point: `--no-verify`
# bypasses it, and it does not exist for anyone who has not run
# `npm run hooks:install`. The check nobody can skip is the CI job that runs
# the same script -- see .github/workflows/release-gate.yml.
#
# Kept deliberately thin: all logic lives in scripts/check-branch-base.js so
# the hook and CI cannot drift apart.

exec node "$(git rev-parse --show-toplevel)/scripts/check-branch-base.js"
